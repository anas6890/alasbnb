generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────
// TYPES EMBARQUÉS (composite types)
// ─────────────────────────────────────────────────────────────────────

type ListingSnapshot {
  listingId String
  title     String
  type      String
  city      String
  country   String
  image     String
  lat       Float
  lng       Float
}

type ExperienceSnapshot {
  experienceId String
  title        String
  category     String
  city         String
  country      String
  image        String
}

type HostSnapshot {
  hostId    String
  firstname String
  lastname  String
  image     String?
}

type PaymentEmbed {
  amount                Int
  currency              String
  status                String
  stripePaymentIntentId String?
  stripeChargeId        String?
  refundId              String?
  refundAmount          Int?
  paidAt                DateTime?
  refundedAt            DateTime?
}

type HostReply {
  content   String
  createdAt DateTime
  updatedAt DateTime?
}

type PriceRule {
  type      String
  label     String?
  discount  Int
  startDate DateTime
  endDate   DateTime
}

type Location {
  address String?
  city    String
  state   String?
  country String
  zipCode String?
  lat     Float
  lng     Float
}

// ─────────────────────────────────────────────────────────────────────
// COLLECTIONS PRINCIPALES
// ─────────────────────────────────────────────────────────────────────

// ── 1. USER ───────────────────────────────────────────────────────────
model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  firstname      String
  lastname       String
  phone          String?
  bio            String?
  image          String?
  governmentId   String?
  isVerified     Boolean   @default(false)
  preferredLang  String    @default("fr")
  currency       String    @default("MAD")

  savedListingIds    String[] @db.ObjectId
  savedExperienceIds String[] @db.ObjectId

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts           Account[]
  listings           Listing[]
  experiences        Experience[]
  reservations       Reservation[]
  reviews            Review[]
  sentMessages       Message[]      @relation("SentMessages")
  recvMessages       Message[]      @relation("ReceivedMessages")
  guestConversations Conversation[] @relation("GuestConversations")
  hostConversations  Conversation[] @relation("HostConversations")
  notifications      Notification[]
}

// ── 2. ACCOUNT (OAuth) ────────────────────────────────────────────────
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ── 3. LISTING ────────────────────────────────────────────────────────
model Listing {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  hostId          String        @db.ObjectId
  status          ListingStatus @default(DRAFT)
  title           String
  description     String
  type            String // apartment | house | villa | cabin | boat | treehouse
  pricePerNight   Int
  cleaningFee     Int           @default(0)
  securityDeposit Int           @default(0)
  weeklyDiscount  Int           @default(0) // %
  monthlyDiscount Int           @default(0) // %
  priceRules      PriceRule[]

  // Capacité
  maxGuests Int
  bedrooms  Int
  beds      Int
  bathrooms Int

  // Médias & équipements
  images    String[]
  amenities String[]

  // Localisation
  location Location

  // Règles maison
  instantBook        Boolean            @default(false)
  petsAllowed        Boolean            @default(false)
  smokingAllowed     Boolean            @default(false)
  partiesAllowed     Boolean            @default(false)
  minNights          Int                @default(1)
  maxNights          Int                @default(365)
  checkInTime        Int                @default(14)
  checkOutTime       Int                @default(11)
  cancellationPolicy CancellationPolicy @default(FLEXIBLE)

  // Stats dénormalisées — mises à jour côté applicatif à chaque Review
  avgRating              Float @default(0)
  totalReviews           Int   @default(0)
  avgRatingCleanliness   Float @default(0)
  avgRatingAccuracy      Float @default(0)
  avgRatingCheckin       Float @default(0)
  avgRatingCommunication Float @default(0)
  avgRatingLocation      Float @default(0)
  avgRatingValue         Float @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user           User                  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  reservations   Reservation[]
  availabilities ListingAvailability[]
  reviews        Review[]
  conversations  Conversation[]
}

// ── 4. LISTING AVAILABILITY ───────────────────────────────────────────
model ListingAvailability {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  listingId   String   @db.ObjectId
  date        DateTime
  isAvailable Boolean  @default(true)
  customPrice Int?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId, isAvailable, date])
}

// ── 5. EXPERIENCE ─────────────────────────────────────────────────────
model Experience {
  id     String        @id @default(auto()) @map("_id") @db.ObjectId
  hostId String        @db.ObjectId
  status ListingStatus @default(DRAFT)

  title       String
  category    String // cuisine | art | sport | nature | bien-être | culture
  description String

  durationMinutes Int
  pricePerPerson  Int
  maxGroupSize    Int

  images    String[]
  included  String[]
  languages String[]

  location Location

  cancellationPolicy CancellationPolicy @default(FLEXIBLE)

  avgRating    Float @default(0)
  totalReviews Int   @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user          User                @relation(fields: [hostId], references: [id], onDelete: Cascade)
  sessions      ExperienceSession[]
  reviews       Review[]
  conversations Conversation[]

  @@index([hostId])
  @@index([status])
}

// ── 6. EXPERIENCE SESSION ─────────────────────────────────────────────
model ExperienceSession {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  experienceId String   @db.ObjectId
  dateTime     DateTime
  spotsTotal   Int
  spotsLeft    Int
  isCancelled  Boolean  @default(false)
  cancelReason String?

  experience   Experience    @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  @@index([experienceId, isCancelled, dateTime])
  }

// ── 7. RESERVATION ────────────────────────────────────────────────────
// EMBEDDING :
//   payment            → PaymentEmbed  (jamais lu séparément)
//   listingSnapshot    → figé à la création
//   experienceSnapshot → figé à la création
//   hostSnapshot       → figé à la création
//
// RÉFÉRENCE :
//   listingId / sessionId → pour les requêtes côté hôte
//   userId               → pour les requêtes admin
//   - Index (userId, createdAt)       → "mes réservations" côté guest
//   - Index (listingId, createdAt)    → "réservations de mon logement" côté hôte
//   - Index (sessionId, createdAt)    → "réservations d'une session" côté hôte
//   - Index (status, createdAt)       → dashboard admin & cron de nettoyage
//   - hostSnapshot rendu nullable     → évite les crashes si host supprimé
//
model Reservation {
  id   String          @id @default(auto()) @map("_id") @db.ObjectId
  type ReservationType // LISTING | EXPERIENCE

  userId    String  @db.ObjectId
  listingId String? @db.ObjectId
  sessionId String? @db.ObjectId

  // Snapshots figés — insensibles aux modifications ultérieures
  listingSnapshot    ListingSnapshot?
  experienceSnapshot ExperienceSnapshot?
  hostSnapshot       HostSnapshot?

  // Dates (logement uniquement)
  checkIn  DateTime?
  checkOut DateTime?
  nights   Int?

  // Voyageurs
  adults   Int @default(1)
  children Int @default(0)
  infants  Int @default(0)
  pets     Int @default(0)

  // Prix snapshot — figé à la réservation
  pricePerNight  Int?
  pricePerPerson Int?
  cleaningFee    Int    @default(0)
  serviceFee     Int    @default(0)
  taxes          Int    @default(0)
  totalPrice     Int
  currency       String @default("EUR")

  // Statut & annulation
  status             ReservationStatus  @default(PENDING)
  cancellationPolicy CancellationPolicy @default(FLEXIBLE)
  cancelledAt        DateTime?
  cancelReason       String?
  cancelledBy        String? // userId de l'annulateur

  payment PaymentEmbed?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing?           @relation(fields: [listingId], references: [id], onDelete: SetNull)
  session ExperienceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

// ── 8. REVIEW ─────────────────────────────────────────────────────────
model Review {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  authorId      String  @db.ObjectId
  reservationId String  @db.ObjectId
  listingId     String? @db.ObjectId
  experienceId  String? @db.ObjectId

  ratingCleanliness   Int?
  ratingAccuracy      Int?
  ratingCheckin       Int?
  ratingCommunication Int?
  ratingLocation      Int?
  ratingValue         Int?

  avgRating Float
  comment String

  hostReply HostReply?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author      User        @relation(fields: [authorId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
  listing     Listing?    @relation(fields: [listingId], references: [id])
  experience  Experience? @relation(fields: [experienceId], references: [id])

  @@index([listingId, createdAt(sort: Desc)])
  @@index([experienceId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([listingId, deletedAt])
}

// ── 9. MESSAGE ────────────────────────────────────────────────────────
model Message {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  senderId       String    @db.ObjectId
  receiverId     String    @db.ObjectId
  conversationId String    @db.ObjectId
  content        String
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([receiverId, isRead])
}

// ── 11. CONVERSATION ──────────────────────────────────────────────────
model Conversation {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  guestId      String   @db.ObjectId
  hostId       String   @db.ObjectId
  listingId    String?  @db.ObjectId
  experienceId String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guest      User        @relation("GuestConversations", fields: [guestId], references: [id], onDelete: Cascade)
  host       User        @relation("HostConversations", fields: [hostId], references: [id], onDelete: Cascade)
  listing    Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  experience Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@index([guestId, updatedAt(sort: Desc)])
  @@index([hostId, updatedAt(sort: Desc)])
}

// ── 10. NOTIFICATION ──────────────────────────────────────────────────
model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum ReservationType {
  LISTING
  EXPERIENCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  DISPUTED
}

enum CancellationPolicy {
  FLEXIBLE // remboursement complet jusqu'à 24h avant
  MODERATE // remboursement complet jusqu'à 5 jours avant
  STRICT // remboursement 50% jusqu'à 7 jours avant
  NON_REFUNDABLE
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  REVIEW_RECEIVED
  MESSAGE_RECEIVED
  PAYMENT_RECEIVED
  REFUND_PROCESSED
}
